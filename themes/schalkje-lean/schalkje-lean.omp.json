{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,#292929>\ue0b2</>",
          "foreground": "#fb7e14",
          "background": "#292929",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} "
        },
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,#ffff66>\ue0b2</>",
          "foreground": "#292929",
          "background": "#ffff66",
          "template": " \uf0e7 "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,#fb7e14>\ue0b2</>",
          "foreground": "#292929",
          "background": "#fb7e14",
          "options": { "style": "agnoster_short", "max_depth": 2, "home_icon": "~", "folder_icon": "\u2026" },
          "template": " \uf07b {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0",
          "foreground": "#D4E157",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff79c6{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}#26C6DA{{ end }}"
          ],
          "background": "#292929",
          "options": { "branch_icon": "\ue725 ", "fetch_status": true, "fetch_upstream_icon": true },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,#3d3d3d>\ue0b2</>",
          "foreground": "#fb7e14",
          "background": "#3d3d3d",
          "options": { "always_enabled": true, "style": "austin", "threshold": 0 },
          "template": " \uf252 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0",
          "foreground": "#292929",
          "background": "#fb7e14",
          "options": { "time_format": "15:04:05" },
          "template": " \u2665 {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#fb7e14",
          "foreground_templates": ["{{ if gt .Code 0 }}#ff5555{{ end }}"],
          "options": { "always_enabled": true },
          "template": "\ue285"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#fb7e14",
    "background": "transparent",
    "template": "\u2665 {{ now | date \"15:04:05\" }} \uf252 {{ .Segments.Executiontime.FormattedMs }}{{ if .Segments.Git.HEAD }} \ue725 {{ .Segments.Git.HEAD }}{{ end }} \ue285 "
  }
}
